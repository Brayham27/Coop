{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/demo/(.*)", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/", "destination": "/landing.html" }
  ]
}
